{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "engineer",
  "permissions": [
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "playwright_*", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "*/rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "*/rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "unlink *", "effect": "ask" },
    { "action": "shell", "resource": "find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *-- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -f *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout * -f *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --force *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout * --force *", "effect": "ask" },
    { "action": "shell", "resource": "git switch -f *", "effect": "ask" },
    { "action": "shell", "resource": "git switch * -f *", "effect": "ask" },
    { "action": "shell", "resource": "git switch --force *", "effect": "ask" },
    { "action": "shell", "resource": "git switch * --force *", "effect": "ask" },
    { "action": "shell", "resource": "git switch *--discard-changes*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "doas *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *-*R*", "effect": "ask" },
    { "action": "shell", "resource": "chmod *--recursive*", "effect": "ask" },
    { "action": "shell", "resource": "chown *-*R*", "effect": "ask" },
    { "action": "shell", "resource": "chown *--recursive*", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *-*R*", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *--recursive*", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "diskutil erase*", "effect": "ask" },
    { "action": "shell", "resource": "diskutil partition*", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "ask" },
    { "action": "shell", "resource": "reboot *", "effect": "ask" },
    { "action": "shell", "resource": "docker rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker rmi *", "effect": "ask" },
    { "action": "shell", "resource": "docker * rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker * prune *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose *down*", "effect": "ask" },
    { "action": "shell", "resource": "docker-compose *down*", "effect": "ask" },
    { "action": "shell", "resource": "podman rm *", "effect": "ask" },
    { "action": "shell", "resource": "podman rmi *", "effect": "ask" },
    { "action": "shell", "resource": "podman * rm *", "effect": "ask" },
    { "action": "shell", "resource": "podman * prune *", "effect": "ask" },
    { "action": "shell", "resource": "podman compose *down*", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ],
  "websearch": { "provider": "random" },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "--yes", "--cache", ".cache/playwright-mcp/npm", "@playwright/mcp@0.0.81", "--browser", "chrome", "--headless", "--isolated", "--sandbox", "--output-dir", ".cache/playwright-mcp/output"],
        "codemode": true,
        "timeout": { "startup": 120000, "execution": 60000 }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "codemode": true,
        "timeout": { "execution": 60000 }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  }
}
